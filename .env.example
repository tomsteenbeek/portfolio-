# =====================================================================
# Digitale Informatie | Strategie & Portfolio – configuratie (statische site + Supabase)
# Kopieer naar .env.local voor lokaal ontwikkelen. Zet NOOIT wachtwoorden in git.
# =====================================================================

# Supabase-project (Project Settings → API). De publishable/anon key is publiek
# by design: hij komt in de JavaScript van de site terecht.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Basispad bij publicatie op GitHub Pages (wordt in de workflow automatisch gezet)
NEXT_PUBLIC_BASE_PATH=

# Alleen voor de scripts (migraties en seed), NIET voor de site zelf:
# Supabase → Connect → Session pooler (vervang [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.<project-ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_VERIFY=false
SEED_DEV_USERS=true

# --- Lokaal ontwikkelen zonder Supabase-project ---
# Lokale PostgreSQL + nabootsing van de Supabase-API:
#   DATABASE_URL=postgres://postgres@localhost:5432/di_portfolio_dev  (en DATABASE_SSL weglaten)
#   npm run dev:gateway   → NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321, NEXT_PUBLIC_SUPABASE_ANON_KEY=lokaal
