# =====================================================================
# Digitale Informatie | Strategie & Portfolio – voorbeeldconfiguratie
# Kopieer naar .env.local (ontwikkeling). Zet NOOIT echte geheimen in git.
# Next.js laadt per omgeving: .env.development / .env.test / .env.production
# (+ .local-varianten). Zie README > Configuratie.
# =====================================================================
APP_ENV=development

# PostgreSQL (lokaal, Docker, Supabase-Postgres of Azure Database for PostgreSQL)
DATABASE_URL=postgres://postgres@localhost:5432/di_portfolio_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Authenticatie: 'dev' (fictieve gebruikers, alleen ontwikkeling) of 'entra'
AUTH_MODE=dev
# Minimaal 32 willekeurige tekens, bv.: openssl rand -base64 48
SESSION_SECRET=vervang-door-minimaal-32-willekeurige-tekens

# Microsoft Entra ID (OIDC) – alleen bij AUTH_MODE=entra
APP_BASE_URL=http://localhost:3000
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Huisstijl: pad naar goedgekeurd logo in /public/brand (optioneel)
NEXT_PUBLIC_BRAND_LOGO=

# Seed: fictieve ontwikkelgebruikers aanmaken (false in test-/productieomgevingen met echte accounts)
SEED_DEV_USERS=true
