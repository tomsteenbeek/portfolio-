# Productieconfiguratie – waarden via de secret store van het hostingplatform
# (bv. Azure Key Vault / App Service-instellingen), niet via bestanden in git.
APP_ENV=production
DATABASE_URL=postgres://app_login:<wachtwoord>@<server>.postgres.database.azure.com:5432/di_portfolio?sslmode=require
DATABASE_SSL=true
AUTH_MODE=entra
SESSION_SECRET=<uit secret store>
APP_BASE_URL=https://<interne-host>
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=<uit secret store>
SEED_DEV_USERS=false
